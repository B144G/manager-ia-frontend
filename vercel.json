{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/connexion.html", "destination": "/connexion", "permanent": true },
    { "source": "/inscription.html", "destination": "/inscription", "permanent": true },
    { "source": "/reinitialiser.html", "destination": "/reinitialiser", "permanent": true },
    { "source": "/app.html", "destination": "/app", "permanent": true },
    { "source": "/chat.html", "destination": "/chat", "permanent": true },
    { "source": "/form.html", "destination": "/form", "permanent": true },
    { "source": "/favicon.ico", "destination": "/favicon.svg", "permanent": false },
    { "source": "/apple-touch-icon.png", "destination": "/assets/icons/icon-192.png", "permanent": false },
    { "source": "/apple-touch-icon-precomposed.png", "destination": "/assets/icons/icon-192.png", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://manager-ia-backend.onrender.com/api/:path*" },
    { "source": "/((?!api/|assets/|video/|sw\\.js|manifest\\.webmanifest|offline\\.html|favicon\\.svg|robots\\.txt|sitemap\\.xml|google[a-zA-Z0-9]+\\.html).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), payment=(), microphone=(self)" }
    ] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/assets/(.*)\\.(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(img|icons)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
