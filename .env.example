# =====================================================================
#  MANAGER-IA : réglages du SITE (frontend React / Vite)
#  Ce fichier ne contient AUCUN secret : ce sont des adresses publiques.
#  Copiez-le en « .env » pour le développement ; sur Vercel, saisissez ces variables dans Settings > Environment Variables.
# =====================================================================

# Adresse du serveur (API) si le site et le serveur sont sur deux domaines différents SANS redirection.
# LAISSEZ VIDE (recommandé) : les appels « /api/... » restent sur le même domaine que le site ;
#   - en développement, Vite les renvoie vers DEV_API_TARGET ;
#   - sur Vercel, le fichier vercel.json les renvoie vers le serveur Render (cookies « du même site » : ça marche aussi sur iPhone/Safari).
# Exemple si vous préférez appeler Render directement (cookies SameSite=None côté serveur, moins fiable sur Safari) :
#   VITE_API_BASE=https://manager-ia-backend.onrender.com
VITE_API_BASE=

# Développement seulement : adresse du serveur local vers lequel Vite renvoie /api.
DEV_API_TARGET=http://localhost:3000

# WhatsApp de l'équipe (lien « Nous écrire » de l'accueil), chiffres seulement avec l'indicatif du pays.
VITE_SUPPORT_WHATSAPP=237653621388
